---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="page-header">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lead">
      The page you were looking for doesn't exist or may have moved. Try the download page or head
      back home.
    </p>
    <div class="actions">
      <a class="button" href="/">Go home</a>
      <a class="button secondary" href="/download">Download OotD</a>
    </div>
  </section>
</BaseLayout>
