---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { faqs } from '@/data/site';
---

<BaseLayout title="FAQ" description="Frequently asked questions about Outlook on the Desktop.">
  <section class="page-header">
    <p class="eyebrow">Support</p>
    <h1>Frequently Asked Questions</h1>
    <p class="lead">Common compatibility and usage notes for Outlook on the Desktop.</p>
  </section>

  <section class="section faq-list">
    {faqs.map((faq) => (
      <article class="faq-item">
        <h2>{faq.question}</h2>
        {faq.answerHtml ? <p set:html={faq.answerHtml} /> : <p>{faq.answer}</p>}
      </article>
    ))}
  </section>
</BaseLayout>