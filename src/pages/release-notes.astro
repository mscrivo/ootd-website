---
import BaseLayout from '@/layouts/BaseLayout.astro';
import legacyReleaseNotesHtml from '@/content/legacy-release-notes.html?raw';
import { site } from '@/data/site';
---

<BaseLayout title="Release Notes" description="Release notes and changelog for Outlook on the Desktop.">
  <section class="page-header">
    <p class="eyebrow">Changelog</p>
    <h1>Release Notes</h1>
    <p class="lead">Current release highlights and the legacy release history from the original site.</p>
  </section>

  <section class="section split">
    <div class="release-panel">
      <h2>{site.latestVersion}</h2>
      <h3>Important</h3>
      <ul>
        <li>Windows SmartScreen may flag this version as an unknown publisher because current builds are not code signed.</li>
        <li>OotD only works with Outlook Classic, not the new Outlook app.</li>
      </ul>
      <h3>Features</h3>
      <ul>
        <li>Added Simplified Chinese, Japanese, and Portuguese (Brazil) localizations.</li>
      </ul>
      <h3>Fixes</h3>
      <ul>
        <li>Fixed an issue where certain view types were reset to the default calendar view when restarting the app.</li>
      </ul>
    </div>
    <div class="callout">
      <h2>Newer releases</h2>
      <p>
        Newer release changelogs are maintained on GitHub. The updater feed still exists for the app, but this page is the readable release history.
      </p>
      <div class="actions">
        <a class="button" href={site.releasesUrl}>GitHub releases</a>
      </div>
    </div>
  </section>

  <section class="section legacy-release-notes" set:html={legacyReleaseNotesHtml} />
</BaseLayout>