---
import BaseLayout from '@/layouts/BaseLayout.astro';
import legacyReleaseNotesHtml from '@/content/legacy-release-notes.html?raw';
import { site } from '@/data/site';
---

<BaseLayout title="Legacy Release Notes" description="Release notes for older versions of Outlook on the Desktop.">
  <section class="page-header">
    <p class="eyebrow">Changelog</p>
    <h1>Legacy Release Notes</h1>
    <p class="lead">Release notes for older versions of OotD. Changelogs for newer releases live on GitHub.</p>
  </section>

  <section class="section split">
    <div class="callout">
      <h2>Looking for the latest version?</h2>
      <p>
        The current release and its changelog are on the download page. Newer release changelogs are maintained on GitHub.
      </p>
      <div class="actions">
        <a class="button" href="/download">Download {site.latestVersion}</a>
        <a class="button secondary" href={site.releasesUrl}>GitHub releases</a>
      </div>
    </div>
  </section>

  <section class="section legacy-release-notes" set:html={legacyReleaseNotesHtml} />
</BaseLayout>
