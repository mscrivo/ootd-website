---
import BaseLayout from '@/layouts/BaseLayout.astro';
import legacyReleaseNotesHtml from '@/content/legacy-release-notes.html?raw';
import { site } from '@/data/site';
---

<BaseLayout
  title="Legacy Release Notes"
  description="Release notes for older versions of Outlook on the Desktop."
>
  <section class="page-header">
    <p class="eyebrow">Changelog</p>
    <h1>Legacy Release Notes</h1>
    <p class="lead">
      Release notes for older versions of OotD. Notes for 3.0 and later are on the release notes
      page.
    </p>
  </section>

  <section class="section split">
    <div class="callout">
      <h2>Looking for the latest version?</h2>
      <p>
        The current release is on the download page, and its changes are on the release notes page.
      </p>
      <div class="actions">
        <a class="button" href="/download">
          Download {site.latestVersion}
        </a>
        <a class="button secondary" href="/release-notes">
          Release notes
        </a>
      </div>
    </div>
  </section>

  <section class="section legacy-release-notes" set:html={legacyReleaseNotesHtml} />
</BaseLayout>
