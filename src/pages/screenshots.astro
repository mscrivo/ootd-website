---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { screenshots } from '@/data/site';

// Thumbnails are cropped to a uniform 16:10 grid, so each one links to the uncropped
// full-size image.
const fullSize = await Promise.all(
  screenshots.map((screenshot) => getImage({ src: screenshot.image, format: 'webp' })),
);
---

<BaseLayout
  title="Screenshots"
  description="Screenshots of Outlook on the Desktop running on Windows."
>
  <section class="page-header">
    <p class="eyebrow">Product views</p>
    <h1>Screenshots</h1>
    <p class="lead">
      Examples of OotD calendar views, multiple instances, tray controls, and configuration screens.
    </p>
  </section>

  <section class="section screenshot-grid">
    {screenshots.map((screenshot, index) => (
      <article class="screenshot">
        <a href={fullSize[index].src} title="View full size">
          <Image src={screenshot.image} alt={screenshot.alt} loading="lazy" format="webp" />
        </a>
        <h3>{screenshot.title}</h3>
      </article>
    ))}
  </section>
</BaseLayout>
