---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { features, screenshots, site } from '@/data/site';

const releaseDate = new Date(site.releaseDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const iconPaths: Record<string, string> = {
  check: 'M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z',
  pin: 'M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z',
  gear: 'M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z',
  monitor:
    'M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H3V4h18v12z',
  calendar:
    'M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z',
  list: 'M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z',
  warning: 'M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z',
  clock:
    'M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z',
  ruler:
    'M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 10H3V8h2v4h2V8h2v4h2V8h2v4h2V8h2v4h2V8h2v8z',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  url: site.url,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows',
  softwareVersion: site.latestVersion,
  datePublished: site.releaseDate,
  downloadUrl: site.downloadUrl,
  softwareRequirements: 'Microsoft Outlook Classic (2010 or higher)',
  image: new URL(site.ogImage, site.url).toString(),
  author: {
    '@type': 'Person',
    name: 'Michael Scrivo',
    url: 'https://michaelscrivo.com/',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout structuredData={structuredData}>
  <section class="hero">
    <div>
      <p class="eyebrow">Windows utility for Outlook Classic</p>
      <h1>Outlook on the Desktop</h1>
      <p class="lead">
        Keep your Outlook calendar, inbox, notes, tasks, and folders visible directly on your
        desktop without opening the full Outlook window.
      </p>
      <div class="actions">
        <a class="button" href={site.downloadUrl}>Download Installer</a>
        <a class="button secondary" href="/screenshots">View screenshots</a>
      </div>
      <p class="release-meta">
        Latest release {site.latestVersion} &middot; <time datetime={site.releaseDate}
          >{releaseDate}</time
        >
      </p>
    </div>
    <div class="product-shot">
      <Image
        src={screenshots[0].image}
        alt={screenshots[0].alt}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Features</h2>
    <div class="feature-grid">
      {
        features.map((feature) => (
          <article class="feature">
            <div class="feature-head">
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d={iconPaths[feature.icon]} />
                </svg>
              </span>
              <h3>{feature.title}</h3>
            </div>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section how-to">
    <h2 class="section-title">How to put Outlook on your desktop</h2>
    <p class="lead">
      Outlook on the Desktop turns your Microsoft Outlook calendar into a desktop calendar widget
      for Windows — a live month, week, or day view pinned to your wallpaper so your schedule is
      always in sight. Here is how to get your calendar on the desktop in three steps.
    </p>
    <div class="feature-grid">
      <article class="feature">
        <div class="feature-head">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d={iconPaths.clock}></path></svg>
          </span>
          <h3>1. Install in seconds</h3>
        </div>
        <p>
          Download the installer and run it. Setup fetches the required .NET runtime for you if it
          is not already on your PC, so there is nothing else to configure.
        </p>
      </article>
      <article class="feature">
        <div class="feature-head">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d={iconPaths.pin}></path></svg>
          </span>
          <h3>2. Pin Outlook to the desktop</h3>
        </div>
        <p>
          OotD hosts the Outlook Classic view directly on your desktop, behind your other windows,
          so your calendar, inbox, tasks, and notes stay visible without opening the full Outlook
          app.
        </p>
      </article>
      <article class="feature">
        <div class="feature-head">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d={iconPaths.ruler}></path></svg>
          </span>
          <h3>3. Size it to your screens</h3>
        </div>
        <p>
          Drag, resize, and set the opacity to taste, then place separate instances across multiple
          monitors. Your layout is saved when you exit, so it returns exactly how you left it.
        </p>
      </article>
    </div>
  </section>

  <section class="section split">
    <div>
      <h2>Built for people who live in Outlook</h2>
      <p class="lead">
        Outlook on the Desktop is useful when your schedule is the center of your day and switching
        windows is friction you do not need.
      </p>
    </div>
    <div class="callout">
      <h3 class="callout-title">
        <span class="callout-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d={iconPaths.warning}></path></svg>
        </span>
        Important compatibility note
      </h3>
      <p>
        The latest OotD versions require Outlook Classic. If Windows has switched you to the new
        Outlook, switch back to Classic before using OotD.
      </p>
    </div>
  </section>
</BaseLayout>
