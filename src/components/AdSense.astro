---
import { site } from '@/data/site';

interface Props {
  slot?: string;
  format?: string;
  responsive?: boolean;
}

const { slot, format = 'auto', responsive = true } = Astro.props;
---

<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.publisherId}`} crossorigin="anonymous"></script>
{slot && (
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={site.publisherId}
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={responsive ? 'true' : 'false'}
  />
)}
{slot && <script is:inline>{`(adsbygoogle = window.adsbygoogle || []).push({});`}</script>}