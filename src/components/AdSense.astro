---
// Loads the AdSense library once. Render this in <head> exactly once per page.
// To place an ad unit in page content, use AdUnit.astro instead.
import { site } from '@/data/site';
---

<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.publisherId}`}
  crossorigin="anonymous"></script>
