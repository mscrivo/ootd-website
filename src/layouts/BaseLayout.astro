---
import AdSense from '@/components/AdSense.astro';
import { navItems, site } from '@/data/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative URL for the social-share image. */
  image?: string;
  /** One or more JSON-LD objects to emit as <script type="application/ld+json">. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, image = site.ogImage, structuredData } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
// `build.format: 'file'` makes pathnames end in `.html` (e.g. `/download.html`)
// at build time, while dev serves clean URLs. Normalize both to the clean path
// Caddy actually serves so canonical/og:url and nav active-state stay correct.
const currentPath =
  Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/\/$/, '') || '/';
const canonicalUrl = new URL(currentPath, site.url).toString();
const imageUrl = new URL(image, site.url).toString();
const jsonLd = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Michael Scrivo" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(site.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href="/assets/ootd-logo.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
    <AdSense />
    <script
      is:inline
      data-goatcounter="https://ootd.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Outlook on the Desktop home">
          <img src="/assets/ootd-logo.svg" alt="" width="48" height="48" />
          <span class="brand-name">
            <span class="brand-name-main">OotD</span>
            <span class="brand-name-sub">Outlook on the Desktop</span>
          </span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
          aria-label="Toggle navigation menu"
        >
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <nav id="primary-nav" aria-label="Primary navigation">
          {
            navItems.map((item) => {
              const isExternal = item.href.startsWith('http');
              const itemPath = isExternal ? item.href : item.href.replace(/\/$/, '') || '/';
              const isActive = !isExternal && itemPath === currentPath;
              const isIcon = item.icon === 'github';
              return (
                <a
                  class:list={[
                    'nav-link',
                    { 'is-active': isActive, 'is-external': isExternal, 'is-icon': isIcon },
                  ]}
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  aria-label={isIcon ? item.label : undefined}
                >
                  {isIcon ? (
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5v-1.78c-2.78.62-3.37-1.22-3.37-1.22-.45-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.08 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.98c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.64 1.03 2.76 0 3.95-2.34 4.82-4.57 5.07.36.32.68.95.68 1.92v2.7c0 .28.18.6.69.5A10.18 10.18 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
                    </svg>
                  ) : (
                    item.label
                  )}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>{site.name}</strong>
        <p>A Windows utility by <a href="https://michaelscrivo.com/">Michael Scrivo</a>.</p>
      </div>
      <div class="footer-links">
        <a href={site.sourceUrl}>GitHub</a>
        <a href="/legacy-release-notes">Legacy release notes</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('primary-nav');
      if (toggle && nav) {
        const close = () => {
          nav.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        };
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        nav.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a')) close();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.classList.contains('is-open')) {
            close();
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
